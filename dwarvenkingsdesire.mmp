          <effect on="1" autoquit_numerator="4" autoquit_syncmode="0" autoquit="1" name="peakcontrollereffect" wet="1" autoquit_denominator="4">
            <peakcontrollereffectcontrols decay="0" abs="1" amount="1" effectId="27329" amountmult="32" mute="0" base="0" attack="0" treshold="0"/>
            <key/>
          </effect>
        </fxchain>
      </mixerchannel>
      <mixerchannel muted="0" volume="1" num="10" soloed="0" name="Drums">
        <fxchain numofeffects="1" enabled="1">
