        <patterntrack/>
        <patternclip autoresize="1" len="192" muted="0" name="No" off="0" pos="1344"/>
        <patternclip autoresize="0" len="768" muted="0" name="thunder, only lightning, are the things you see in front of you, the" off="0" pos="1536"/>
        <patternclip autoresize="0" len="768" muted="0" name="deafness only frightning those who can't perceive the world in truth. Behind the " off="0" pos="2304"/>
        <patternclip autoresize="0" len="768" muted="0" name="mirror, you may glimpse at a projection of my soul. But can you really see," off="0" pos="3072"/>
        <patternclip autoresize="0" len="768" muted="0" name="could you grasp the whole of it? It is out of your control." off="0" pos="3840"/>
      </track>
