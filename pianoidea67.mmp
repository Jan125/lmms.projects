            <stereomatrixcontrols l-l="0.5" l-r="0.5" r-l="0.5" r-r="0.5"/>
            <key/>
          </effect>
          <effect autoquit="1" autoquit_denominator="4" autoquit_numerator="4" autoquit_syncmode="0" name="vsteffect" on="1" wet="1">
            <vsteffectcontrols guivisible="0" numparams="8" param0="0:Size:0.91" param1="1:Damping:0.3" param2="2:Predelay:0.5" param3="3:Hi Damp:0.5" param4="4:Lo Cut:1" param5="5:Early Ref.:0" param6="6:Mix:0.14" param7="7:Level:0.5" plugin="Effects\Classic Reverb\Classic Reverb.dll" program="0"/>
            <key>
              <attribute name="file" value="Effects\Classic Reverb\Classic Reverb.dll"/>
            </key>
          </effect>
        </fxchain>
        <send amount="1" channel="0"/>
      </mixerchannel>
    </mixer>
